/* ═══════════════════════════════════════════════════════════
   并网计划 GRID-IN PROJECT — 全局样式
   视觉与「华电保定·校园通」网页版保持一致：
   浅绿底 / 白卡片 / 华电绿主色 / 深绿标题 / 蓝链接 / 琥珀提示
═══════════════════════════════════════════════════════════ */

page {
  --bg: #f4f7f5;          /* 页面底色（浅绿灰） */
  --panel: #ffffff;       /* 面板 */
  --panel-2: #e8f4ee;     /* 次级面板 / 表头 */
  --line: #dde6e0;        /* 描边 */
  --line-soft: #e7ede9;   /* 弱描边 */
  --green: #1e7a4f;       /* 华电绿（主色） */
  --green-d: #124a30;     /* 深绿（标题） */
  --green-l: #e8f4ee;     /* 浅绿底 */
  --blue: #0b62c4;        /* 链接蓝 */
  --amber: #d99a2b;       /* 琥珀（提示条） */
  --amber-bg: #fdf6ec;
  --amber-t: #7a5a1e;
  --text: #1f2733;        /* 正文 */
  --text-2: #2c3a4d;      /* 次级正文 */
  --gray: #68788e;        /* 次要文字 */
  --gray-dim: #9aa7b5;    /* 更浅的灰 */

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* ── 通用容器 ───────────────────────────────── */
.wrap { padding: 24rpx 24rpx 60rpx; }

/* 顶部等宽小字标签，呼应网页版的分区小标题 */
.eyebrow {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--gray-dim);
  text-transform: uppercase;
}

/* ── 面板 ───────────────────────────────────── */
.panel {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}
.panel.tight { padding: 20rpx; }
.panel.flat { background: var(--panel-2); }

/* 面板左上角绿色标记（对应网页版 h2 的左侧绿边） */
.panel.marked::before {
  content: '';
  position: absolute;
  left: 0; top: 0;
  width: 6rpx; height: 46rpx;
  background: var(--green);
}

/* ── 板块标题 ───────────────────────────────── */
.sec-head { margin: 34rpx 0 18rpx; }
.sec-head:first-child { margin-top: 8rpx; }
.sec-head .sec-tag {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--green);
}
.sec-head .sec-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green-d);
  letter-spacing: 1rpx;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}
.sec-head .sec-name::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, var(--line), transparent);
  margin-left: 18rpx;
}
.sec-head .sec-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 6rpx;
}

/* ── 页面级板块头（section / contest 页） ───── */
.sec-hero { padding: 12rpx 0 0; }
.sec-hero .sh-name {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--green-d);
  margin-top: 10rpx;
  line-height: 1.25;
}
.sec-hero .sh-desc {
  font-size: 25rpx;
  color: var(--gray);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ── 卡片标题 ───────────────────────────────── */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--green-d);
  line-height: 1.5;
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ── 竞赛等级角标 ───────────────────────────── */
.badge {
  display: inline-block;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  line-height: 1.6;
  flex-shrink: 0;
}
.badge.bA { background: #c0392b; color: #ffffff; }
.badge.bB { background: #d4791f; color: #ffffff; }
.badge.bC { background: #2c7fb8; color: #ffffff; }
.badge.bX { background: #5b8c5a; color: #ffffff; }

/* ── 键值行（rows） ─────────────────────────── */
.kv { display: flex; padding: 10rpx 0; }
.kv + .kv { border-top: 1rpx solid var(--line-soft); }
.kv .k {
  width: 130rpx;
  flex-shrink: 0;
  color: var(--gray);
  font-size: 25rpx;
}
.kv .v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
  word-break: break-all;
}

/* ── 链接按钮 ───────────────────────────────── */
.link-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.link-btn {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--green-d);
  border: 1rpx solid #cfe6da;
  background: var(--green-l);
  border-radius: 6rpx;
  padding: 8rpx 20rpx;
  line-height: 1.6;
  max-width: 100%;
}
.link-btn:active { background: #d7ebe1; }
.link-btn.tel {
  color: var(--amber-t);
  border-color: #eddcb6;
  background: var(--amber-bg);
}
.link-btn.file {
  color: var(--blue);
  border-color: #cddff4;
  background: #eef4fc;
}
.link-btn .lb-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-btn .lb-arrow { margin-left: 8rpx; font-family: monospace; }

/* ── 提示条（note） ─────────────────────────── */
.note {
  background: var(--amber-bg);
  border-left: 5rpx solid var(--amber);
  border-radius: 0 6rpx 6rpx 0;
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  color: var(--amber-t);
  margin: 18rpx 0;
  line-height: 1.75;
}
.note.plain {
  background: #f2f5f3;
  border-left-color: var(--line);
  color: var(--gray);
}

/* ── 步骤（steps） ──────────────────────────── */
.steps { margin: 8rpx 0; }
.step { display: flex; padding: 12rpx 0; }
.step .num {
  width: 44rpx; height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--green);
  color: #ffffff;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  margin-top: 4rpx;
}
.step .st-body { flex: 1; }
.step .st-t { font-size: 27rpx; font-weight: 600; color: var(--text-2); }
.step .st-d { font-size: 25rpx; color: var(--gray); margin-top: 4rpx; line-height: 1.7; }

/* ── 表格（table） ──────────────────────────── */
.tbl { margin: 12rpx 0; overflow: hidden; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--panel); }
.tbl-cap {
  font-size: 24rpx;
  color: var(--green-d);
  background: var(--green-l);
  padding: 12rpx 18rpx;
  font-weight: 600;
}
.tbl-row { display: flex; border-top: 1rpx solid var(--line-soft); }
.tbl-row:nth-child(odd) { background: #fafcfb; }
.tbl-row.head { background: var(--green-l); }
.tbl-row.head .tbl-cell { color: var(--green-d); font-weight: 600; font-size: 24rpx; }
.tbl-cell {
  flex: 1;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.65;
  border-left: 1rpx solid var(--line-soft);
  word-break: break-all;
}
.tbl-cell:first-child { border-left: none; }

/* ── 图片（imgs） ───────────────────────────── */
.fig { margin: 16rpx 0; }
.fig .fig-img {
  width: 100%;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: #f7faf8;
}
.fig .fig-cap {
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ── 来源标注 ───────────────────────────────── */
.src-line {
  font-size: 22rpx;
  color: var(--gray-dim);
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line-soft);
  line-height: 1.65;
}
.src-line .src-k { color: var(--gray); }

/* ── 检索框 ─────────────────────────────────── */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 0 22rpx;
  height: 84rpx;
}
.search-bar .sb-icon { color: var(--gray-dim); font-size: 30rpx; margin-right: 14rpx; }
.search-bar input {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
  height: 84rpx;
}
.search-bar .sb-clear { color: var(--gray-dim); font-size: 30rpx; padding: 0 6rpx; }

/* ── 筛选条 ─────────────────────────────────── */
.filter-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 16rpx 0;
}
.chip {
  font-size: 24rpx;
  color: var(--green-d);
  border: 1rpx solid var(--green);
  border-radius: 6rpx;
  padding: 6rpx 18rpx;
  background: var(--panel);
}
.chip.on {
  color: #ffffff;
  background: var(--green);
  border-color: var(--green);
  font-weight: 600;
}

/* ── 横向滚动筛选 ───────────────────────────── */
.hscroll { white-space: nowrap; margin: 16rpx -24rpx; padding: 0 24rpx; }
.hscroll .chip { display: inline-block; margin-right: 12rpx; }

/* ── 空态 ───────────────────────────────────── */
.empty {
  text-align: center;
  color: var(--gray-dim);
  font-size: 26rpx;
  padding: 90rpx 0;
  font-family: monospace;
}

/* ── 列表项（导航用） ───────────────────────── */
.nav-item {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.nav-item:active { background: var(--green-l); }
.nav-item .ni-idx {
  font-family: monospace;
  font-size: 22rpx;
  color: var(--green);
  width: 56rpx;
  flex-shrink: 0;
}
.nav-item .ni-body { flex: 1; min-width: 0; }
.nav-item .ni-name { font-size: 29rpx; font-weight: 600; color: var(--green-d); }
.nav-item .ni-desc { font-size: 23rpx; color: var(--gray); margin-top: 4rpx; }
.nav-item .ni-arrow { color: var(--gray-dim); font-family: monospace; margin-left: 12rpx; }

/* ── 品牌分隔条（浅绿渐变） ─────────────────── */
.brand-rule {
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--green), rgba(30, 122, 79, 0.08));
  margin: 20rpx 0;
}

/* ── 计数徽标 ───────────────────────────────── */
.count {
  font-family: monospace;
  font-size: 22rpx;
  color: #ffffff;
  background: var(--green);
  border-radius: 10rpx;
  padding: 0 12rpx;
  margin-left: 10rpx;
}

/* 富文本容器 */
.rich { font-size: 26rpx; line-height: 1.8; color: var(--text-2); word-break: break-all; }
