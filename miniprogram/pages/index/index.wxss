/* ══ 品牌头 ══ */
.hero { padding: 14rpx 0 4rpx; }

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-main {
  display: flex;
  align-items: center;
  margin: 22rpx 0 12rpx;
}

/* 纯 CSS 闪电（品牌主图形） */
.bolt {
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--yellow);
  clip-path: polygon(60% 0%, 20% 54%, 45% 54%, 36% 100%, 80% 42%, 52% 42%);
}

.hero-title {
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  line-height: 1.08;
  color: var(--white);
}

.hero-en {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: var(--yellow);
  margin-top: 6rpx;
}

.hero-sub {
  font-size: 28rpx;
  color: var(--gray);
  letter-spacing: 3rpx;
}

.hero-meta {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 21rpx;
  color: var(--gray-dim);
  margin-top: 14rpx;
}
.hero-meta .dot { margin: 0 10rpx; }

/* ══ 简介 ══ */
.intro-sub {
  font-size: 24rpx;
  color: var(--yellow);
  margin: 10rpx 0 16rpx;
  line-height: 1.6;
}

.intro-text { position: relative; }
.intro-text.clamp { max-height: 230rpx; overflow: hidden; }
.intro-text.clamp::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 90rpx;
  background: linear-gradient(rgba(26,32,40,0), var(--panel));
}

.expand {
  text-align: center;
  color: var(--yellow);
  font-size: 24rpx;
  padding-top: 14rpx;
}
.expand:active { opacity: .6; }

/* ══ 常用入口 ══ */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.quick-item {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  padding: 22rpx 16rpx;
  position: relative;
  overflow: hidden;
}
.quick-item:active { background: var(--panel-2); }

/* 右上角小切角装饰 */
.quick-item::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  border-width: 0 18rpx 18rpx 0;
  border-style: solid;
  border-color: transparent var(--line) transparent transparent;
}

.qi-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--white);
  line-height: 1.4;
}

.qi-desc {
  font-size: 20rpx;
  color: var(--gray);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ══ 地图 ══ */
.map-card { padding: 20rpx; }
.map-thumb {
  width: 100%;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  display: block;
}
.map-cap {
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 12rpx;
  text-align: center;
}

/* ══ 检索入口 ══ */
.search-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(245, 197, 0, 0.07);
  border: 1rpx dashed rgba(245, 197, 0, 0.4);
  border-radius: 10rpx;
  padding: 26rpx;
  color: var(--yellow);
  font-size: 26rpx;
  margin-top: 30rpx;
}
.search-entry:active { background: rgba(245, 197, 0, 0.15); }
.se-icon { font-size: 32rpx; }

/* ══ 页脚 ══ */
.foot {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: var(--gray-dim);
  line-height: 1.8;
}
