/* ══ 搜索框 ══ */
.search-bar { margin-top: 22rpx; }

.sb-input {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
  height: 84rpx;
  min-width: 0;
}

.ph {
  color: var(--gray-dim);
  font-size: 26rpx;
}

/* ══ 院系横向滚动 ══ */
.hscroll-inner { display: inline-block; }

/* ══ 结果条 ══ */
.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 14rpx;
  font-size: 24rpx;
  color: var(--gray);
}

.rb-hint { color: var(--gray-dim); font-size: 22rpx; }

.rb-reset {
  color: var(--green);
  border: 1rpx solid rgba(30, 122, 79, 0.35);
  border-radius: 6rpx;
  padding: 4rpx 18rpx;
  font-size: 23rpx;
}
.rb-reset:active { background: rgba(30, 122, 79, 0.12); }

/* ══ 加载提示 ══ */
.more {
  text-align: center;
  color: var(--gray-dim);
  font-size: 23rpx;
  padding: 28rpx 0;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.more.end { color: #c3ccd6; }
